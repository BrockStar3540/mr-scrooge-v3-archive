{
  "runtime": {
    "scan_interval_seconds": 60,
    "dry_run": true,
    "log_level": "INFO"
  },
  "broker": {
    "adapter": "oanda",
    "environment": "practice",
    "account_id": ""
  },
  "risk": {
    "max_open_positions": 5,
    "max_daily_loss_pct": 3.0,
    "margin_utilization": 0.4,
    "cooldown_after_stop_minutes": 60,
    "zone_blacklist_hours": 4,
    "zone_bucket_pips": 20,
    "max_consecutive_expiries": 3,
    "backoff_minutes": 30
  },
  "features": {
    "atr": {
      "enabled": true,
      "mode": "active",
      "period": 14
    },
    "bollinger": {
      "enabled": true,
      "mode": "active",
      "period": 20,
      "std_dev": 2.0
    },
    "otr": {
      "enabled": true,
      "mode": "active"
    },
    "spread_monitor": {
      "enabled": true,
      "mode": "active"
    }
  },
  "classifiers": {
    "regime": {
      "enabled": true,
      "mode": "active"
    },
    "bb_state": {
      "enabled": true,
      "mode": "active"
    },
    "opening_state": {
      "enabled": true,
      "mode": "active"
    },
    "structure": {
      "enabled": true,
      "mode": "active"
    }
  },
  "strategies": {
    "reversal": {
      "enabled": true,
      "mode": "active"
    },
    "trend": {
      "enabled": false,
      "mode": "disabled",
      "size_full": 0.5,
      "size_stretch": 0.3
    },
    "gap": {
      "enabled": false,
      "mode": "disabled"
    },
    "measured_move": {
      "enabled": false,
      "mode": "disabled"
    },
    "dbb_trend": {
      "enabled": true,
      "mode": "active",
      "lookback_bars": 12,
      "pullback_max_retrace_pct": 0.55,
      "min_breakout_body_pct": 0.55,
      "min_rr": 1.1,
      "stop_buffer_pips": 2,
      "fixed_score": 32
    },
    "routing_table_path": "data/routing_table_v7.parquet",
    "routing_table_mode": "hard",
    "routing_telemetry": {
      "enabled": true,
      "flush_every": 100,
      "death_sample_rate": 10
    }
  },
  "gates": {
    "debounce": {
      "enabled": true,
      "mode": "hard"
    },
    "zone_entry_cap": {
      "enabled": true,
      "mode": "hard"
    },
    "regime_floor": {
      "enabled": true,
      "mode": "hard",
      "min_score": -4
    },
    "_note": "Only 3 gates are live. spread/otr/rr/exhaustion/nat_stop/spread_vs_stop handled by V3 scorer.",
    "_removed_gates": [
      "spread",
      "otr",
      "rr",
      "exhaustion",
      "nat_stop_validity",
      "spread_vs_stop"
    ],
    "sub_regime_filter": {
      "mode": "hard"
    }
  },
  "execution": {
    "trigger_side_validation": true,
    "no_mans_zone_guard": true,
    "spread_aware_trailing": true
  },
  "advisors": {
    "ml_regime": {
      "enabled": false,
      "mode": "observe"
    },
    "ml_trade_scorer": {
      "enabled": false,
      "mode": "observe"
    },
    "llm_analyst": {
      "enabled": false,
      "mode": "observe"
    }
  },
  "telemetry": {
    "decision_audit": true,
    "execution_audit": true,
    "replay_logs": true
  },
  "dashboard": {
    "enabled": true,
    "port": 8084,
    "host": "127.0.0.1"
  },
  "management": {
    "tp1_r": 1.0,
    "ratchet": {
      "ratchet_trigger_r": 1.0,
      "ratchet_trigger_min_pips": 3.0,
      "ratchet_lock_pct": 0.5
    },
    "break_even": {
      "be_trigger_r": 0.5,
      "be_trigger_min_pips": 1.0,
      "be_offset_r": 0.1,
      "be_offset_min_pips": 1.0
    },
    "exit_manager": {
      "early_hold_threshold_r": 0.5,
      "lock_threshold_r": 0.8,
      "min_sl_step_pips": 1.0
    },
    "dust_unit_threshold": 2,
    "favorable_exit": {
      "enabled": true,
      "favorable_exit_offset_pips": 0.5,
      "favorable_exit_expiry_seconds": 600,
      "peak_retrace_pct": 0.5,
      "min_peak_r": 1.0
    }
  },
  "scoring": {
    "ml_filter": {
      "enabled": true,
      "mode": "hard",
      "_note": "Per-strategy XGBoost filter. observe = log only, hard = drop below threshold. dbb_trend p>=0.5 calibrated."
    },
    "branch_router": {
      "enabled": false,
      "mode": "observe",
      "model_path": "data/ml-observer-offline/models/branch_router_T0.xgb",
      "thresholds": {
        "freeze": 0.55,
        "min_confidence": 0.58,
        "min_margin": 0.08
      },
      "_note": "Pre-gate branch router. Enable after running trainer pipeline."
    }
  }
}