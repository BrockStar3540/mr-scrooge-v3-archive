    "ml_trade_scorer": {
      "enabled": false,
      "mode": "observe"
    },
    "llm_analyst": {
      "enabled": false,
      "mode": "observe"
    }
  },
  "telemetry": {
    "decision_audit": true,
    "execution_audit": true,
    "replay_logs": true
  },
  "dashboard": {
    "enabled": true,
    "port": 8084,
    "host": "127.0.0.1"
  },
  "management": {
    "tp1_r": 1.0,
    "ratchet": {
      "_comment": "Brock 2026-06-01 Option A \u2014 6-step scalper schedule, constant 0.5p buffer between trigger and lock",
      "scalper_steps": [
        [
          3.5,
          2.5
        ],
        [
          5.5,
          5.0
        ],
        [
          7.5,
          7.0
        ],
        [
          10.5,
          10.0
        ],
        [
          13.0,
          12.5
        ],
        [
          15.5,
          15.0
        ],
        [
          20.5,
          20.0
        ],
        [
          30.5,
          30.0
        ]
      ]
    },
    "break_even": {
      "be_trigger_r": 0.786,
      "be_trigger_min_pips": 5.5,
      "be_offset_r": 0.714,
      "be_offset_min_pips": 5.0
    },
    "exit_manager": {
      "early_hold_threshold_r": 0.5,
      "lock_threshold_r": 0.8,
      "min_sl_step_pips": 1.0
    },
    "dust_unit_threshold": 2,
    "favorable_exit": {
      "enabled": true,
      "favorable_exit_offset_pips": 0.5,
      "favorable_exit_expiry_seconds": 600,
      "peak_retrace_pct": 0.5,
      "min_peak_r": 1.0
    },
    "harvest": {
      "tp1_fraction": 0.0,
      "_note": "tp1_fraction=0 means no partial harvest. Full position runs to TP2/ratchet/favorable_exit. Brock 2026-05-16: 1:2 effective R:R was crushing winners."
    }
  },
  "scoring": {
    "ml_filter": {
      "enabled": false,
      "mode": "observe",
      "_note": "Per-strategy XGBoost filter. observe = log only, hard = drop below threshold. dbb_trend p>=0.5 calibrated."
    },
    "branch_router": {
      "enabled": false,
      "mode": "observe",
      "model_path": "data/ml-observer-offline/models/branch_router_T0.xgb",
      "thresholds": {
        "freeze": 0.55,
        "min_confidence": 0.58,
        "min_margin": 0.08
      },
      "_note": "Pre-gate branch router. Enable after running trainer pipeline."
    }
  }
