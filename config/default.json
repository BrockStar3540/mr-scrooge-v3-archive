      "enabled": true,
      "mode": "hard"
    },
    "zone_entry_cap": {
      "enabled": true,
      "mode": "hard"
    },
    "regime_floor": {
      "enabled": true,
      "mode": "hard",
      "min_score": -4
    },
    "_note": "Only 3 gates are live. spread/otr/rr/exhaustion/nat_stop/spread_vs_stop handled by V3 scorer.",
    "_removed_gates": [
      "spread",
      "otr",
      "rr",
      "exhaustion",
      "nat_stop_validity",
      "spread_vs_stop"
    ],
    "sub_regime_filter": {
      "mode": "hard"
    },
    "entry_filter": {
      "min_tier": "Seed-Pro",
      "mode": "hard",
      "enable_family_loose_override": false
    },
    "entry_filter_shadow": {
      "routing_table_path": "data/routing_table_v9_observe.parquet",
      "min_tier": "Seed",
      "mode": "observe"
    },
    "natural_target_floor": {
      "min_pips": 5.0,
      "mode": "hard",
      "enabled": false
