{
  "runtime": {
    "scan_interval_seconds": 60,
    "dry_run": true,
    "log_level": "INFO"
  },
  "broker": {
    "adapter": "oanda",
    "environment": "practice",
    "account_id": ""
  },
  "risk": {
    "max_open_positions": 2,
    "max_daily_loss_pct": 3.0,
    "margin_utilization": 0.4,
    "cooldown_after_stop_minutes": 60,
    "zone_blacklist_hours": 4,
    "zone_bucket_pips": 20,
    "max_consecutive_expiries": 3,
    "backoff_minutes": 30
  },
  "features": {
    "atr": {
      "enabled": true,
      "mode": "active",
      "period": 14
    },
    "bollinger": {
      "enabled": true,
      "mode": "active",
      "period": 20,
      "std_dev": 2.0
    },
    "otr": {
      "enabled": true,
      "mode": "active"
    },
    "spread_monitor": {
      "enabled": true,
      "mode": "active"
    }
  },
  "classifiers": {
    "regime": {
      "enabled": true,
      "mode": "active"
    },
    "bb_state": {
      "enabled": true,
      "mode": "active"
    },
    "opening_state": {
      "enabled": true,
      "mode": "active"
    },
    "structure": {
      "enabled": true,
      "mode": "active"
    }
  },
  "strategies": {
    "reversal": {
      "enabled": true,
      "mode": "active"
    },
    "trend": {
      "enabled": false,
      "mode": "disabled",
      "size_full": 0.5,
      "size_stretch": 0.3
    },
    "gap": {
      "enabled": false,
      "mode": "disabled"
    },
    "measured_move": {
      "enabled": false,
      "mode": "disabled"
    },
    "dbb_trend": {
      "enabled": true,
      "mode": "active",
      "lookback_bars": 12,
      "pullback_max_retrace_pct": 0.55,
      "min_breakout_body_pct": 0.55,
      "min_rr": 1.1,
      "stop_buffer_pips": 2,
      "fixed_score": 32
    },
    "routing_table_path": "data/routing_table_v10_fast_v1_12_comprehensive.parquet",
    "routing_table_mode": "hard",
    "routing_telemetry": {
      "enabled": true,
      "flush_every": 100,
      "death_sample_rate": 10
    },
    "probes_v2": {
      "BR2_vcb_long": {
        "enabled": true
      },
      "BR2_vcb_short": {
        "enabled": true
      },
      "CP3_vol_coil_fade_long": {
        "enabled": true
      },
      "CP3_vol_coil_fade_short": {
        "enabled": true
      },
      "MR4_zscore_extreme_short": {
        "enabled": true
      },
      "MR5_williams_extreme_long": {
        "enabled": true
      },
      "MR5_williams_extreme_short": {
        "enabled": true
      },
      "RG1_range_bound_scalp_short": {
        "enabled": true
      },
      "RG2_range_support_bounce_long": {
        "enabled": true
      },
      "MR4_zscore_extreme_long": {
        "enabled": true
      },
      "MR2_bb_reversion_short": {
        "enabled": true
      },
      "BR3_inside_bar_long": {
        "enabled": true
      },
      "BR3_inside_bar_short": {
        "enabled": true
      },
      "CP1_coil_breakout_long": {
        "enabled": true
      },
      "CP1_coil_breakout_short": {
        "enabled": true
      },
      "CP2_squeeze_momentum_long": {
        "enabled": true
      },
      "TF4_sar_long": {
        "enabled": true
      }
    }
  },
  "gates": {
    "debounce": {
      "enabled": true,
      "mode": "hard"
    },
    "zone_entry_cap": {
      "enabled": true,
      "mode": "hard"
    },
    "regime_floor": {
      "enabled": true,
      "mode": "hard",
      "min_score": -4
    },
    "_note": "Only 3 gates are live. spread/otr/rr/exhaustion/nat_stop/spread_vs_stop handled by V3 scorer.",
    "_removed_gates": [
      "spread",
      "otr",
      "rr",
      "exhaustion",
      "nat_stop_validity",
      "spread_vs_stop"
    ],
    "sub_regime_filter": {
      "mode": "hard"
    },
    "entry_filter": {
      "min_tier": "Seed-Pro",
      "mode": "hard"
    },
    "entry_filter_shadow": {
      "routing_table_path": "data/routing_table_v9_observe.parquet",
      "min_tier": "Seed",
      "mode": "observe"
    }
  },
  "execution": {
    "trigger_side_validation": true,
    "no_mans_zone_guard": true,
    "spread_aware_trailing": true,
    "reverse_direction": true
  },
  "advisors": {
    "ml_regime": {
      "enabled": false,
      "mode": "observe"
    },
    "ml_trade_scorer": {
      "enabled": false,
      "mode": "observe"
    },
    "llm_analyst": {
      "enabled": false,
      "mode": "observe"
    }
  },
  "telemetry": {
    "decision_audit": true,
    "execution_audit": true,
    "replay_logs": true
  },
  "dashboard": {
    "enabled": true,
    "port": 8084,
    "host": "127.0.0.1"
  },
  "management": {
    "tp1_r": 1.0,
    "ratchet": {
      "ratchet_trigger_r": 1.0,
      "ratchet_trigger_min_pips": 3.0,
      "ratchet_lock_pct": 0.5
    },
    "break_even": {
      "be_trigger_r": 0.7,
      "be_trigger_min_pips": 7.0,
      "be_offset_r": 0.6,
      "be_offset_min_pips": 6.0
    },
    "exit_manager": {
      "early_hold_threshold_r": 0.5,
      "lock_threshold_r": 0.8,
      "min_sl_step_pips": 1.0
    },
    "dust_unit_threshold": 2,
    "favorable_exit": {
      "enabled": true,
      "favorable_exit_offset_pips": 0.5,
      "favorable_exit_expiry_seconds": 600,
      "peak_retrace_pct": 0.5,
      "min_peak_r": 1.0
    },
    "harvest": {
      "tp1_fraction": 0.0,
      "_note": "tp1_fraction=0 means no partial harvest. Full position runs to TP2/ratchet/favorable_exit. Brock 2026-05-16: 1:2 effective R:R was crushing winners."
    }
  },
  "scoring": {
    "ml_filter": {
      "enabled": true,
      "mode": "hard",
      "_note": "Per-strategy XGBoost filter. observe = log only, hard = drop below threshold. dbb_trend p>=0.5 calibrated."
    },
    "branch_router": {
      "enabled": false,
      "mode": "observe",
      "model_path": "data/ml-observer-offline/models/branch_router_T0.xgb",
      "thresholds": {
        "freeze": 0.55,
        "min_confidence": 0.58,
        "min_margin": 0.08
      },
      "_note": "Pre-gate branch router. Enable after running trainer pipeline."
    }
  }
}