    "feature_quality_floor": {
      "mode": "hard",
      "critical_features": [
        "ema",
        "rsi",
        "zone_detector"
      ]
    },
    "htf_trend_filter": {
      "mode": "hard",
      "lookback_periods": 20,
      "htf": "D",
      "neutral_pct": 0.0
    },
    "daily_circuit": {
      "enabled": false,
      "mode": "observe"
    },
    "pip_eater": {
      "enabled": true,
      "mode": "hard",
