# Mr. Scrooge V3 — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# OANDA API (required for live trading)
OANDA_API_URL=https://api-fxtrade.oanda.com
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# Dashboard auth
DASHBOARD_USER=admin
DASHBOARD_PASS=

# Override any config value with SCROOGE_ prefix:
# SCROOGE_RUNTIME_DRY_RUN=false
# SCROOGE_RISK_MAX_DAILY_LOSS_PCT=3.0
# SCROOGE_GATES_RR_REVERSAL_MIN_RR=1.0
